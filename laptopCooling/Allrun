#!/bin/sh
cd "${0%/*}/.." || exit 1

# OpenFOAM v2412 环境 (按安装路径修改)
if [ -z "$WM_PROJECT" ]; then
    if [ -f /usr/lib/openfoam/openfoam2412/etc/bashrc ]; then
        . /usr/lib/openfoam/openfoam2412/etc/bashrc
    elif [ -f "$HOME/OpenFOAM/OpenFOAM-v2412/etc/bashrc" ]; then
        . "$HOME/OpenFOAM/OpenFOAM-v2412/etc/bashrc"
    elif [ -f /opt/openfoam2412/etc/bashrc ]; then
        . /opt/openfoam2412/etc/bashrc
    else
        echo "ERROR: 请先 source OpenFOAM v2412 环境 (etc/bashrc)"
        exit 1
    fi
fi

echo "========================================"
echo " MacBook Pro 14 笔记本散热 CHT 算例"
echo " OpenFOAM v2412 / chtMultiRegionSimpleFoam"
echo "========================================"

./Allclean 2>/dev/null

echo "--- blockMesh ---"
blockMesh > log.blockMesh 2>&1 || { tail log.blockMesh; exit 1; }

echo "--- topoSet (部件 cellZone) ---"
topoSet > log.topoSet 2>&1 || { tail log.topoSet; exit 1; }

echo "--- splitMeshRegions ---"
splitMeshRegions -cellZones -overwrite > log.splitMeshRegions 2>&1 \
    || { tail log.splitMeshRegions; exit 1; }

echo "--- setup solid system files ---"
sh scripts/setupSolidSystem.sh

echo "--- write initial fields ---"
python3 scripts/writeInitialFields.py > log.writeInitialFields 2>&1 \
    || { cat log.writeInitialFields; exit 1; }

echo "--- setFields (风扇流道初值) ---"
setFields -region air > log.setFields 2>&1 || { tail log.setFields; exit 1; }

echo "--- chtMultiRegionSimpleFoam ---"
chtMultiRegionSimpleFoam > log.chtMultiRegionSimpleFoam 2>&1
echo "Done. 后处理: paraFoam -multiRegion"
