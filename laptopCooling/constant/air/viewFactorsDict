FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      viewFactorsDict;
}

// OpenFOAM v2412 createViewFactors 必填项
viewFactorModel     viewFactor2AI;
raySearchEngine     voxel;
agglomerate         false;
nRayPerFace         100;
writeViewFactors    true;
writeRays           false;

// voxel 射线引擎可选参数
nTriPerVoxelMax     50;
depthMax            5;
