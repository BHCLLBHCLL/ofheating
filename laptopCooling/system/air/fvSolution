FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    "rho.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-7;
        relTol          0.01;
    }

    p_rgh
    {
        solver          GAMG;
        tolerance       1e-5;
        relTol          0.05;
        maxIter         150;
        smoother        GaussSeidel;
        nPreSweeps      1;
        nPostSweeps     2;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    U
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.1;
    }

    UFinal
    {
        $U;
        relTol          0;
    }

    h
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.1;
    }

    hFinal
    {
        $h;
        relTol          0;
    }

    qr
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-6;
        relTol          0.1;
        nSweeps         2;
    }

    qRFinal
    {
        $qr;
        relTol          0;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    momentumPredictor        no;
    consistent               no;
    hydrostaticInitialization yes;
    nHydrostaticCorrectors   10;
    pRefCell                 0;
    pRefValue                0;

    residualControl
    {
        p_rgh
        {
            tolerance   1e-3;
            relTol      0;
        }
        U
        {
            tolerance   1e-3;
            relTol      0;
        }
        h
        {
            tolerance   1e-5;
            relTol      0.01;
        }
    }
}

relaxationFactors
{
    equations
    {
        U           0.1;
        h           0.3;
        p_rgh       0.02;
        ".*"        0.3;
    }
}
