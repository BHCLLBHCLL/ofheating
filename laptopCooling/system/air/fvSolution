FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    "rho.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-7;
        relTol          0.01;
    }

    p_rgh
    {
        solver          GAMG;
        tolerance       1e-5;
        relTol          0.05;
        maxIter         150;
        smoother        GaussSeidel;
        nPreSweeps      1;
        nPostSweeps     2;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    U
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.1;
    }

    UFinal
    {
        $U;
        relTol          0;
    }

    h
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.1;
    }

    hFinal
    {
        $h;
        relTol          0;
    }

    qr
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-6;
        relTol          0.1;
        nSweeps         2;
    }

    qRFinal
    {
        $qr;
        relTol          0;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    momentumPredictor        no;
    consistent               no;
    hydrostaticInitialization yes;
    nHydrostaticCorrectors   5;
    rhoMin                   0.5;
    rhoMax                   5;

    residualControl
    {
        p_rgh   1e-4;
        U       1e-4;
        h       1e-6;
    }
}

relaxationFactors
{
    equations
    {
        U           0.3;
        h           0.7;
        p_rgh       0.05;
        ".*"        0.5;
    }
}
