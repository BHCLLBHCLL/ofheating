/* -*- C++ -*- */
// blockMesh 后切分双风扇进/排气 patch (OpenFOAM v2412 createPatch)

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

patches
(
    {
        name            fanInletLeft;
        patchInfo
        {
            type            patch;
        }
        constructFrom     set;
        set               fanInletLeftFaces;
    }
    {
        name            fanInletRight;
        patchInfo
        {
            type            patch;
        }
        constructFrom     set;
        set               fanInletRightFaces;
    }
    {
        name            bottomWall;
        patchInfo
        {
            type            wall;
        }
        constructFrom     patches;
        patches         (fanInlet);
    }
    {
        name            exhaustLeft;
        patchInfo
        {
            type            patch;
        }
        constructFrom     set;
        set               exhaustLeftFaces;
    }
    {
        name            exhaustRight;
        patchInfo
        {
            type            patch;
        }
        constructFrom     set;
        set               exhaustRightFaces;
    }
);
