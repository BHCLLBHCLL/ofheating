FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    h
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-6;
        relTol          0.1;
    }

    hFinal
    {
        $h;
        relTol          0;
    }

    e
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-6;
        relTol          0.1;
    }

    eFinal
    {
        $e;
        relTol          0;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;

    residualControl
    {
        h   1e-6;
    }
}

relaxationFactors
{
    equations
    {
        h           0.9;
        ".*"        0.9;
    }
}
