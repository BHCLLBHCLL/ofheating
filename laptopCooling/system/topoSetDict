/* -*- C++ -*- */
// 部件 cellZone (单位: m), dz=0.5mm
// 规则: 固体 zone 互不重叠; 机壳仅为薄壁, 并 delete 与内部固体重叠的单元

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

actions
(
    // --- 主板 FR4: z 1.0-1.5mm (中心 1.25mm) ---
    {
        name    motherboard;
        type    cellZoneSet;
        action  new;
        source  boxToCell;
        box     (0.020 0.020 0.0010) (0.160 0.140 0.0015);
    }
    {
        name    motherboard;
        type    cellZoneSet;
        action  delete;
        source  boxToCell;
        box     (0.055 0.060 0.0010) (0.095 0.100 0.0015);
    }

    // --- CPU: z 1.5-2.0mm (中心 1.75mm), 与 VC 不重叠 ---
    {
        name    cpu;
        type    cellZoneSet;
        action  new;
        source  boxToCell;
        box     (0.055 0.060 0.0015) (0.095 0.100 0.0020);
    }

    // --- VC: z 2.5-3.0mm (中心 2.75mm), 与 CPU 留 2.25mm 空气隙 ---
    {
        name    vc;
        type    cellZoneSet;
        action  new;
        source  boxToCell;
        box     (0.045 0.050 0.0025) (0.105 0.110 0.0030);
    }

    // --- 散热翅片: z >= 3.0mm ---
    {
        name    fins;
        type    cellZoneSet;
        action  new;
        source  boxToCell;
        box     (0.130 0.040 0.0030) (0.170 0.120 0.0090);
    }

    // --- 屏幕后盖 ---
    {
        name    screen;
        type    cellZoneSet;
        action  new;
        source  boxToCell;
        box     (0.010 0.135 0.0105) (0.170 0.158 0.0165);
    }

    // --- 机壳薄壁 (不与内腔体块重叠) ---
    {
        name    chassis;
        type    cellZoneSet;
        action  new;
        source  boxToCell;
        box     (0.000 0.000 0.0000) (0.180 0.160 0.0010);
    }
    {
        name    chassis;
        type    cellZoneSet;
        action  add;
        source  boxToCell;
        box     (0.000 0.000 0.0090) (0.180 0.160 0.0110);
    }
    {
        name    chassis;
        type    cellZoneSet;
        action  add;
        source  boxToCell;
        box     (0.000 0.000 0.0010) (0.008 0.160 0.0095);
    }
    {
        name    chassis;
        type    cellZoneSet;
        action  add;
        source  boxToCell;
        box     (0.172 0.000 0.0010) (0.180 0.160 0.0095);
    }
    {
        name    chassis;
        type    cellZoneSet;
        action  delete;
        source  zoneToCell;
        zones
        (
            cpu
            vc
            motherboard
            fins
            screen
        );
    }

    // --- 空气: 全域减去固体 ---
    {
        name    air;
        type    cellZoneSet;
        action  new;
        source  boxToCell;
        box     (0.000 0.000 0.0000) (0.180 0.160 0.0180);
    }
    {
        name    air;
        type    cellZoneSet;
        action  delete;
        source  zoneToCell;
        zones
        (
            cpu
            vc
            motherboard
            fins
            screen
            chassis
        );
    }
);
