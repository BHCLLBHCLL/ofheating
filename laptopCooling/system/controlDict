FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     chtMultiRegionSimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2000;

deltaT          1;

writeControl    timeStep;

writeInterval   200;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;

functions
{
    resAir
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        region          air;
        writeControl    timeStep;
        writeInterval   1;
        log             true;
        fields
        (
            p_rgh
            U
            h
        );
    }

    resSolids
    {
        type            multiRegion;
        libs            (utilityFunctionObjects);

        function
        {
            type            solverInfo;
            libs            (utilityFunctionObjects);
            writeControl    timeStep;
            writeInterval   1;
            log             true;
            fields          (h);
        }

        regions
        (
            cpu
            vc
            motherboard
            fins
            chassis
            screen
        );
    }
}
